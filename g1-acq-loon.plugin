#!name = G1 ACQ
#!desc = v7.5.0 Loon 版：被动采集 Google One 原始 SKU，执行 2TB/20TB/30TB 三档改写与 75p 回退，保留最近 10 次响应诊断、本机报告和 JSON 导出；需要启用 MitM
#!author = crhywun
#!homepage = https://github.com/crhywun/g1-acq
#!date = 2026-11-24
#!system = iOS

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP；会影响其它 App 的 QUIC。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
# 复用上游 @v7.5.0 脚本；Loon 的 $done({body}) / $done({response}) 语义兼容。
# 本机报告页仍保留上游的“Shadowrocket/小火箭”静态文案，不影响 Loon 执行。
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-acq.js, requires-body=true, binary-body-mode=false, timeout=30, enable=true, tag=G1-ACQ
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js, timeout=30, enable=true, tag=G1-Report

[MITM]
hostname = %APPEND% one.google.com
